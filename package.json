{
  "name": "f2e",
  "engines": {
    "node": "24.x"
  },
  "description": "A collection of unlicensed work for f2e open challenge",
  "repository": {
    "type": "git",
    "url": "https://github.com/Howard86/f2e-2011"
  },
  "author": "Howard Tai <howard@howardism.dev>",
  "license": "UNLICENSED",
  "keywords": [
    "template",
    "next.js",
    "typescript",
    "chakra-ui",
    "framer-motion",
    "redux",
    "redux-toolkit",
    "rtk-query",
    "eslint",
    "prettier",
    "lint-staged",
    "husky",
    "commitlint"
  ],
  "bugs": {
    "url": "https://github.com/Howard86/f2e-2011/issues"
  },
  "homepage": "https://github.com/Howard86/f2e-2011",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:scene": "turbo run build --filter=@f2e/scene",
    "build:ubike": "turbo run build --filter=@f2e/ubike",
    "build:bus": "turbo run build --filter=@f2e/bus",
    "dev:scene": "turbo run dev --filter=@f2e/scene",
    "dev:ubike": "turbo run dev --filter=@f2e/ubike",
    "dev:bus": "turbo run dev --filter=@f2e/bus",
    "start:scene": "turbo run start --filter=@f2e/scene",
    "start:ubike": "turbo run start --filter=@f2e/ubike",
    "start:bus": "turbo run start --filter=@f2e/bus",
    "check-all": "bun run typecheck && bun run lint && bun run format",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.43.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.0.0",
    "turbo": "2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
